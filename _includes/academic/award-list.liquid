<dl class="award-list">
  {% for item in include.items %}
    <div>
      <dt>{{ item[0] }}</dt>
      <dd>
        {{
          item[1]
          | replace: 'National Scholarship', '<strong>National Scholarship</strong>'
          | replace: 'BYD Scholarship', '<strong>BYD Scholarship</strong>'
        }}
      </dd>
    </div>
  {% endfor %}
</dl>
