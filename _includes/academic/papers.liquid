<div class="papers{% if include.compact %} papers-compact{% endif %}{% if include.text_only %} papers-text-only{% endif %}">
  {% for paper in site.data.academic.papers %}
    <article class="paper">
      {% unless include.text_only %}
        <div class="paper-visual">
          <span class="paper-kind">{{ paper.label }}</span>
          <a href="https://arxiv.org/abs/{{ paper.id }}" aria-label="Read {{ paper.title | escape }}">
            <img src="{{ paper.figure | relative_url }}" alt="{{ paper.alt | escape }}" loading="lazy" width="480" height="300">
          </a>
        </div>
      {% endunless %}
      <div class="paper-copy">
        <h3>
          <a href="https://arxiv.org/abs/{{ paper.id }}">{{ paper.title | escape }}</a>
        </h3>
        <p class="authors">
          {% for author in paper.authors -%}
            {%- if author == site.data.academic.name -%}
              <strong>{{ author }}</strong>
            {%- else -%}
              {{ author }}
            {%- endif -%}
            {%- unless forloop.last %}, {% endunless -%}
          {%- endfor %}
        </p>
        <p class="paper-venue">{{ paper.status }}</p>
        {% if paper.history %}
          <p class="paper-history">{{ paper.history }}</p>
        {% endif %}
        <p class="preprint">
          <em>arXiv preprint arXiv:{{ paper.id }}, 2026</em>
        </p>
        <div class="paper-links">
          <a href="https://arxiv.org/abs/{{ paper.id }}" aria-label="arXiv: {{ paper.title | escape }}">ARXIV</a>
          <a href="https://arxiv.org/pdf/{{ paper.id }}" aria-label="PDF: {{ paper.title | escape }}">PDF</a>
        </div>
        {% unless include.compact or include.text_only %}
          <p class="paper-summary">{{ paper.summary }}</p>
        {% endunless %}
      </div>
    </article>
  {% endfor %}
</div>
