<div class="timeline">
  {% for item in include.items %}
    <div class="timeline-row">
      <div class="date">{{ item.date }}</div>
      <div>
        <h3>{{ item.title }}</h3>
        {% if item.description %}
          <p>{{ item.description }}</p>
        {% endif -%}
        {%- if item.url -%}
          <a class="inline-link" href="{{ item.url }}">{{ item.link_label }} ↗</a>
        {%- endif %}
      </div>
    </div>
  {% endfor %}
</div>
