---
layout: academic
---
{% assign a = site.data.academic %}
<div class="page-intro">
  <p class="eyebrow">Curriculum Vitae · October 2026</p>
  <h1>
    {{ a.name }}
    <span lang="zh">{{ a.chinese_name }}</span>
  </h1>
  <p>{{ a.role }} · {{ a.school }}</p>
  <a href="mailto:{{ site.data.socials.email }}">{{ site.data.socials.email }}</a>
  <p class="print-note">A print-friendly CV. Use your browser’s Print command to save as PDF.</p>
</div>
<section class="section">
  <h2>Education</h2>
  <p>{{ a.education }}</p>
</section>
<section class="section">
  <h2>Research Interests</h2>
  <p>{{ a.interests }}</p>
</section>
<section class="section">
  <h2>Research &amp; Preprints</h2>
  {% include academic/papers.liquid text_only=true %}
</section>
<section class="section">
  <h2>Research Affiliations</h2>
  {% include academic/timeline.liquid items=a.affiliations %}
</section>
<section class="section">
  <h2>Research Programs &amp; Projects</h2>
  {% include academic/programs.liquid %}
</section>
<section class="section">
  <h2>Honors &amp; Awards</h2>
  {% for group in a.honor_groups %}
    <h3 class="cv-subheading">{{ group.title }}</h3>
    {% if group.title == 'Innovation & Entrepreneurship' %}{% include academic/special-prizes.liquid %}{% endif %}
    {% include academic/award-list.liquid items=group.items -%}
  {%- endfor %}
</section>
<section class="section">
  <h2>Leadership &amp; Service</h2>
  {% include academic/timeline.liquid items=a.service %}
  <p>{{ a.volunteering }}</p>
</section>
