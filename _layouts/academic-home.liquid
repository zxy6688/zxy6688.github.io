---
layout: academic
---
{% assign a = site.data.academic %}
<section class="biography" aria-labelledby="biography-heading">
  <h1 id="biography-heading">Biography</h1>
  {% for paragraph in a.biography %}
    <p>{{ paragraph }}</p>
  {% endfor %}
</section>
<section class="interests" aria-labelledby="interests-heading">
  <h2 id="interests-heading">Research Interests</h2>
  <p>{{ a.interests }}</p>
</section>
<section id="research" class="section">
  <div class="section-heading">
    <h2>Selected Publications</h2>
    <a href="{{ '/research/' | relative_url }}">All Research →</a>
  </div>
  {% include academic/papers.liquid compact=true %}
</section>
<section class="section">
  <h2>Research Affiliations</h2>
  {% include academic/timeline.liquid items=a.affiliations %}
</section>
<section class="section">
  <div class="section-heading">
    <h2>Research Programs</h2>
    <a href="{{ '/projects/' | relative_url }}">All Projects →</a>
  </div>
  {% include academic/programs.liquid compact=true %}
</section>
<section class="section" id="honors">
  <div class="section-heading">
    <h2>Selected Honors</h2>
    <a href="{{ '/honors/' | relative_url }}">All Honors →</a>
  </div>
  {% include academic/award-list.liquid items=a.selected_honors %}
  {% include academic/special-prizes.liquid %}
</section>
<section class="section" id="news">
  <h2>News</h2>
  {% include academic/news.liquid %}
</section>
<section class="section">
  <div class="section-heading">
    <h2>Leadership &amp; Service</h2>
    <a href="{{ '/cv/' | relative_url }}">Full CV →</a>
  </div>
  <ul class="service-list">
    {% for item in a.service %}
      <li>
        <span>{{ item.short_title }}</span><span class="date">{{ item.date }}</span>
      </li>
    {% endfor %}
  </ul>
</section>
